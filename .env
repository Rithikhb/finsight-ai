# Application & Security
APP_NAME="FinSight AI"
ENVIRONMENT="development"
SECRET_KEY="change-this-to-a-64-char-random-hex-string-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL for Production, SQLite supported for instant local dev)
# DATABASE_URL="postgresql://finsight_user:strong_password@localhost:5432/finsight_db"
DATABASE_URL="sqlite:///./finsight_local.db"

# Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=10
ENABLE_OCR_FALLBACK=false

# Optional Local AI Assistant (Ollama) - Never sends data to external cloud without consent
ENABLE_LOCAL_LLM=false
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"